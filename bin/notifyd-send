#!/usr/bin/env python3
# notifyd-send from a checkout (notify-send and notify-send.py in one): puts ../src on the path, so a symlink in
# ~/.local/bin works without installing.
import os
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), '..', 'src'))

from notifyd.send import standalone_main

sys.exit(standalone_main())
